  ],
  "functions": [
    {
      "acl": [
        "postgres=X/postgres"
      ],
      "name": "recent_signin",
      "schema": "iig_private",
      "definition": "CREATE OR REPLACE FUNCTION iig_private.recent_signin()\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE claims jsonb=coalesce(nullif(current_setting('request.jwt.claims',true),''),'{}')::jsonb;\nBEGIN\n IF NOT EXISTS(SELECT 1 FROM jsonb_array_elements(coalesce(claims->'amr','[]')) a WHERE a->>'method'='otp'\n AND (a->>'timestamp')::numeric BETWEEN extract(epoch FROM now())-600 AND extract(epoch FROM now())+30)\n THEN RAISE EXCEPTION 'Verify a fresh email code within ten minutes for this account change' USING ERRCODE='42501';END IF;\nEND $function$\n"
    }
  ],
